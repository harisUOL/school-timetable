# Copy to .env and adjust. .env is git-ignored.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# One SQLite file per Git branch avoids sharing data between branches.
SQLITE_PATH=db.sqlite3

# Uncomment to use PostgreSQL instead (needs psycopg installed):
# POSTGRES_DB=timetable
# POSTGRES_USER=timetable
# POSTGRES_PASSWORD=secret
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
